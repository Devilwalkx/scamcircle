{
  "expo": {
    "name": "ScamCircle",
    "slug": "scamcircle",
    "version": "0.2.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./public/icon-512.png",
    "ios": { "bundleIdentifier": "app.devilwalkx.scamcircle" },
    "android": {
      "package": "app.devilwalkx.scamcircle",
      "blockedPermissions": [
        "INTERNET",
        "SYSTEM_ALERT_WINDOW",
        "VIBRATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./public/icon-maskable-512.png",
        "backgroundColor": "#0B5A60"
      },
      "predictiveBackGestureEnabled": true,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": ["text/plain", "image/*"]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a picture to crop and share with someone you trust. ScamCircle does not read pictures.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "ScamCircle",
      "shortName": "ScamCircle",
      "backgroundColor": "#F2F6F6",
      "themeColor": "#0B5A60",
      "lang": "en-GB"
    },
    "platforms": ["ios", "android", "web"]
  }
}
